# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit real secrets or passwords to version control.
# ==============================================================================

# Network binding (defaults to 127.0.0.1 for local isolation)
BIND_IP=127.0.0.1

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=file_cloud_db

# Keycloak Administrator Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_admin_password_here

# Backend Service Configuration
SERVER_PORT=5000
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@postgres:5432/file_cloud_db

# OpenID Connect / Keycloak JWT Verification
# In Docker network, backend resolves keycloak via internal DNS (http://keycloak:8080)
JWKS_URI=http://keycloak:8080/realms/file-cloud/protocol/openid-connect/certs
# Tokens issued by Keycloak to browsers bear the external issuer URL
JWT_ISSUER=http://localhost:8080/realms/file-cloud

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

 