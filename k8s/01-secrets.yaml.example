apiVersion: v1
kind: Secret
metadata:
  name: file-cloud-secrets
  namespace: file-cloud
type: Opaque
stringData:
  postgres-user: "postgres"
  postgres-password: "your_secure_password_here"
  postgres-db: "file_cloud_db"
  database-url: "postgresql://postgres:your_secure_password_here@postgres:5432/file_cloud_db"
  keycloak-admin: "admin"
  keycloak-admin-password: "your_secure_admin_password_here"
